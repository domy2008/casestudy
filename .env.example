# IntelliKnow KMS — host-only environment file TEMPLATE.
#
# Copy this file to /opt/intelliknow/.env on the EC2 host and fill in real
# values there. The real .env must NEVER be committed to git (it is covered
# by .gitignore) and never baked into a Docker image. (Req 11.1)

# Fernet master key encrypting /data/credentials/credentials.enc.
# Generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_MASTER_KEY=

# HTTPS forward proxy used ONLY by the Telegram client (Req 12.2).
# Telegram is unreachable from AWS China; all getUpdates/sendMessage traffic
# is routed through this proxy. DashScope and Teams traffic goes direct.
# Example: http://proxy-host.example.com:3128
TELEGRAM_PROXY_URL=

# AWS China region for CloudWatch metrics, logs, and alarms.
# cn-north-1 (Beijing) or cn-northwest-1 (Ningxia).
AWS_DEFAULT_REGION=cn-north-1
# Microsoft Entra tenant (directory) ID — REQUIRED for a Single Tenant Azure
# Bot app registration. Bot Framework tokens are then acquired from the
# tenant-specific OAuth2 endpoint. Leave empty for a Multi Tenant app.
# Example: 12345678-1234-1234-1234-123456789abc
TEAMS_TENANT_ID=
